generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id @default(uuid())
  email    String   @unique
  password String
  resumes  Resume[]
  jobs     Job[]
}

model Resume {
  id        String   @id @default(uuid())
  userId    String?
  content   String
  score     Float?   // ← was Int, Groq returns decimals
  feedback  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id]) // ← optional relation
}

model Job {
  id        String   @id
  userId    String?
  status    String   @default("pending") // pending | processing | done | failed
  jobRole   String
  fileName  String
  result    String?  // JSON stringified
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}